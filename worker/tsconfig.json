{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // worker-configuration.d.ts is generated by `npm run types`: the Env type
  // from wrangler.jsonc, plus the Workers runtime types.
  "include": ["src", "worker-configuration.d.ts"]
}
