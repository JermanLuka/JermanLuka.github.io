---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import ResultCards from '../components/ResultCards.astro';
import portrait from '../assets/portrait.png';
import { skillLogos } from '../lib/skills';
import { formatDate, isoDate } from '../lib/date';

// Copies of the stack list in the scrolling strip. Half the strip must be
// wider than the screen, or its end slides into view before the loop resets.
// One copy is about 1,440px, so six cover screens up to about 4,300px.
const marqueeCopies = 6;

const projects = (
  await getCollection('projects', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const posts = (
  await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const profiles = [
  { href: 'https://github.com/JermanLuka', label: 'GitHub' },
  {
    href: 'https://www.linkedin.com/in/luka-jerman-12046442b/',
    label: 'LinkedIn',
  },
];

/** Off-site links open in a new tab and identify the profile as mine. */
const external = (href: string) =>
  href.startsWith('http')
    ? { target: '_blank', rel: 'me noopener noreferrer' }
    : {};
---

<Layout
  description="Luka Jerman, software engineer. I build the systems that businesses run on every day, in C# and .NET."
  width="full"
>
  {/* Each block rises in on its own animation-delay, so the hero assembles
      top to bottom. On desktop it fills the screen below the header (4rem),
      so it gets the first view to itself. */}
  <section class="mx-auto grid max-w-6xl items-center gap-14 px-5 pt-16 pb-16 sm:px-6 sm:pt-24 lg:min-h-[calc(100svh-4rem)] lg:grid-cols-[1.2fr_0.8fr] lg:gap-16 lg:py-16">
    <div>
      {/* The name and the claim both sit in the h1 so search engines still
          read the name, even though the claim is what's visually loud. */}
      <h1>
        <span class="glass inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-semibold tracking-[0.14em] text-zinc-300 uppercase motion-safe:animate-rise">
          <span class="size-1.5 rounded-full bg-dot"></span>
          Luka Jerman
        </span>
        <span
          class="mt-7 block font-display text-[clamp(2.6rem,4.6vw,3.9rem)] leading-[0.95] tracking-[0.01em] text-white uppercase motion-safe:animate-rise"
          style="animation-delay:80ms"
        >
          I build production software that runs <span class="text-accent-500">fast</span>.
        </span>
      </h1>

      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-zinc-400 motion-safe:animate-rise sm:text-xl"
        style="animation-delay:200ms"
      >
        I've written software for fishing fleets, factories, banks and
        healthcare providers. <span class="text-zinc-100">I optimize systems and back it up with
        numbers.</span>
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3 motion-safe:animate-rise" style="animation-delay:280ms">
        <a
          href="/cv"
          class="group inline-flex items-center gap-2 rounded-full bg-accent-700 px-6 py-3 text-sm font-semibold text-white glow-button transition hover:bg-accent-600 hover:glow-button-strong"
        >
          Read the CV
          <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
        </a>
        <a
          href="#work"
          class="glass rounded-full px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
        >
          See the work
        </a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-xs motion-safe:animate-rise lg:mr-0" style="animation-delay:200ms">
      <div
        aria-hidden="true"
        class="absolute -inset-4 rounded-[2.5rem] bg-linear-to-br from-accent-800/25 via-accent-950/20 to-warm-900/15 blur-3xl"
      ></div>

      <figure class="glass relative rounded-[2rem] p-0.5">
        <Image
          src={portrait}
          alt="Luka Jerman"
          width={480}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full rounded-[1.875rem] object-cover"
        />
      </figure>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-12 sm:px-6">
    <p class="text-xs font-semibold tracking-[0.18em] text-accent-500 uppercase">Results</p>
    <h2 class="mt-3 font-display text-4xl tracking-[0.01em] text-white uppercase sm:text-5xl">Measured in production</h2>

    <div class="mt-12">
      <ResultCards />
    </div>
  </section>

  {/* Identical copies of the list; the animation slides the track by exactly
      half, then jumps back to where it started. The second half looks the
      same as the first, so the jump is invisible and the loop runs forever.
      Each loop slides half the copies, so the duration scales with them to
      keep the speed at 45s per copy. */}
  <section aria-label="Tech stack" class="fade-x mt-28 overflow-hidden">
    <div
      class="flex w-max hover:[animation-play-state:paused] motion-safe:animate-marquee"
      style={`animation-duration:${(marqueeCopies / 2) * 45}s`}
    >
      {
        Array.from({ length: marqueeCopies }, (_, copy) => (
          <ul
            aria-hidden={copy > 0 ? 'true' : undefined}
            class="flex shrink-0 gap-3 pr-3 text-sm text-zinc-300"
          >
            {skillLogos.map((skill) => (
              <li class="flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 whitespace-nowrap">
                {skill.path ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4" fill={`#${skill.darkHex ?? skill.hex}`}>
                    <path d={skill.path} />
                  </svg>
                ) : (
                  <span aria-hidden="true" class="size-2 rounded-full" style={`background:#${skill.darkHex ?? skill.hex}`} />
                )}
                {skill.name}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  {
    projects.length > 0 && (
      <section id="work" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-28 sm:px-6">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold tracking-[0.18em] text-accent-500 uppercase">Selected work</p>
            <h2 class="mt-3 font-display text-4xl tracking-[0.01em] text-white uppercase sm:text-5xl">Things I've built</h2>
          </div>
          <a href="/projects" class="text-sm text-zinc-400 transition hover:text-white">All projects →</a>
        </div>

        <ul class="mt-12 grid gap-5 md:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard
              id={project.id}
              href={`/projects/${project.id}`}
              title={project.data.title}
              status={project.data.status}
              summary={project.data.summary}
              tags={project.data.tags}
            />
          ))}
        </ul>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 pb-28 sm:px-6">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold tracking-[0.18em] text-warm-400 uppercase">Writing</p>
            <h2 class="mt-3 font-display text-4xl tracking-[0.01em] text-white uppercase sm:text-5xl">Notes from the build</h2>
          </div>
          <a href="/blog" class="text-sm text-zinc-400 transition hover:text-white">All posts →</a>
        </div>

        <ul class="glass mt-10 divide-y divide-white/5 overflow-hidden rounded-3xl">
          {posts.map((post) => (
            <PostRow
              href={`/blog/${post.id}`}
              title={post.data.title}
              date={formatDate(post.data.date)}
              datetime={isoDate(post.data.date)}
              summary={post.data.summary}
            />
          ))}
        </ul>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-6">
    <div class="glass relative overflow-hidden rounded-[2rem] px-6 py-20 text-center sm:px-16">
      <div
        aria-hidden="true"
        class="absolute top-0 left-1/2 h-64 w-[36rem] max-w-full -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-900/30 blur-[100px]"
      ></div>

      <h2 class="relative mx-auto max-w-3xl font-display text-4xl tracking-[0.01em] text-white uppercase sm:text-6xl">
        Need a project built or optimized?
      </h2>
      <p class="relative mx-auto mt-5 max-w-xl text-zinc-400">
        Send me a message, or find me on GitHub and LinkedIn.
      </p>

      <div class="relative mt-10 flex flex-wrap justify-center gap-3">
        <a
          href="/contact"
          class="group inline-flex items-center gap-2 rounded-full bg-accent-700 px-6 py-3 text-sm font-semibold text-white glow-button transition hover:bg-accent-600"
        >
          Send me a message
          <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
        </a>
        {
          profiles.map(({ href, label }) => (
            <a
              href={href}
              {...external(href)}
              class="glass rounded-full px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
            >
              {label} <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
