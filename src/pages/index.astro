---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../assets/portrait.jpg';
import SkillGrid from '../components/SkillGrid.astro';
import EntryCard from '../components/EntryCard.astro';
import { skillLogos } from '../lib/skills';
import { experience, intro, lead } from '../lib/cv';
import { formatDate, isoDate } from '../lib/date';

const current = experience[0];

const projects = (
  await getCollection('projects', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const [latestPost] = (
  await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const linkClass =
  'underline decoration-slate-300 underline-offset-4 transition-colors hover:decoration-slate-600 dark:decoration-slate-700 dark:hover:decoration-slate-400';
---

<Layout description={lead}>
  <section
    class="flex flex-col-reverse gap-x-10 gap-y-6 pt-2 sm:flex-row sm:items-start sm:justify-between"
  >
    <div class="min-w-0">
      <h1 class="text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100">
        Luka Jerman
      </h1>

      <p class="mt-3 text-sm font-medium text-slate-700 dark:text-slate-300">
        Back-end software engineer
      </p>

      <p
        class="mt-6 border-l-2 border-slate-300 pl-4 text-lg leading-relaxed text-slate-700 dark:border-slate-700 dark:text-slate-300"
      >
        {lead}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
        <a
          href="/cv"
          class="rounded-md bg-slate-900 px-4 py-2 font-medium text-white transition-colors hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white"
        >
          Read the CV
        </a>
        <a href="/projects" class={linkClass}>Projects</a>
        <a href="/blog" class={linkClass}>Blog</a>
        <a href="/contact" class={linkClass}>Contact</a>
      </div>
    </div>

    <Image
      src={portrait}
      alt="Luka Jerman"
      width={400}
      densities={[1, 2]}
      loading="eager"
      class="h-28 w-28 shrink-0 rounded-2xl object-cover ring-1 ring-slate-200 sm:h-36 sm:w-36 dark:ring-slate-800"
    />
  </section>

  <section id="about" class="mt-14">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
      About
    </h2>

    <div class="mt-6 space-y-4 leading-relaxed text-slate-600 dark:text-slate-400">
      {intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="mt-14">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
      What I work with
    </h2>

    <div class="mt-6">
      <SkillGrid skills={skillLogos} />
    </div>
  </section>

  <section class="mt-14">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
      Now
    </h2>

    <div class="mt-6">
      <div class="flex items-baseline justify-between gap-x-4">
        <h3 class="min-w-0 font-medium text-slate-900 dark:text-slate-100">
          {current.role} &middot; {current.org}
        </h3>
        <span class="shrink-0 whitespace-nowrap text-sm text-slate-500 dark:text-slate-400">
          {current.period}
        </span>
      </div>
      <p class="mt-2 leading-relaxed text-slate-600 dark:text-slate-400">
        {current.blurb}
      </p>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="mt-14">
        <div class="flex items-baseline justify-between gap-x-4">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Selected projects
          </h2>
          <a href="/projects" class={`text-sm ${linkClass}`}>
            All projects
          </a>
        </div>

        <ul class="mt-6 space-y-4">
          {projects.map((project) => (
            <EntryCard
              href={`/projects/${project.id}`}
              title={project.data.title}
              meta={project.data.status}
              summary={project.data.summary}
              tags={project.data.tags}
            />
          ))}
        </ul>
      </section>
    )
  }

  {
    latestPost && (
      <section class="mt-14">
        <div class="flex items-baseline justify-between gap-x-4">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Latest post
          </h2>
          <a href="/blog" class={`text-sm ${linkClass}`}>
            All posts
          </a>
        </div>

        <ul class="mt-6">
          <EntryCard
            href={`/blog/${latestPost.id}`}
            title={latestPost.data.title}
            meta={formatDate(latestPost.data.date)}
            datetime={isoDate(latestPost.data.date)}
            summary={latestPost.data.summary}
            tags={latestPost.data.tags}
          />
        </ul>
      </section>
    )
  }
</Layout>
