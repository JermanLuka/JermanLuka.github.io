---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import CopyEmail from '../components/CopyEmail.astro';
import portrait from '../assets/portrait.jpg';
import { skillLogos } from '../lib/skills';
import { experience, yearsOfExperience } from '../lib/cv';
import { formatDate, isoDate } from '../lib/date';
import { email } from '../lib/contact';

const current = experience[0];

const years = yearsOfExperience();

// Copies of the stack list in the scrolling strip. Half the strip must be
// wider than the screen, or its end slides into view before the loop resets.
// One copy is about 1,440px, so six cover screens up to about 4,300px.
const marqueeCopies = 6;

const projects = (
  await getCollection('projects', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const posts = (
  await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const profiles = [
  { href: 'https://github.com/JermanLuka', label: 'GitHub' },
  {
    href: 'https://www.linkedin.com/in/luka-jerman-12046442b/',
    label: 'LinkedIn',
  },
];

/** Off-site links open in a new tab and identify the profile as mine. */
const external = (href: string) =>
  href.startsWith('http')
    ? { target: '_blank', rel: 'me noopener noreferrer' }
    : {};
---

<Layout
  description="Luka Jerman, software engineer. I build the systems that businesses run on every day, in C# and .NET."
  width="full"
>
  <section class="mx-auto grid max-w-6xl items-center gap-14 px-5 pt-16 pb-20 sm:px-6 sm:pt-24 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
    <div>
      {/* Both lines sit in the h1 so search engines still read the name,
          even though the role is what's visually loud. */}
      <h1>
        <span class="glass inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-semibold tracking-[0.14em] text-zinc-300 uppercase">
          <span class="size-1.5 rounded-full bg-dot"></span>
          Luka Jerman
        </span>
        <span class="mt-7 block font-display text-[clamp(2.75rem,5.5vw,4.25rem)] leading-[0.95] tracking-[0.01em] text-white uppercase">
          Software Engineer
        </span>
      </h1>

      <p class="mt-6 max-w-xl text-2xl leading-snug font-medium text-zinc-100 sm:text-[1.75rem]">
        I build the systems that businesses run on every day.
      </p>

      <p class="mt-4 max-w-xl text-lg leading-relaxed text-zinc-400">
        C# and .NET, on everything from satellite vessel monitoring and
        manufacturing ERP to certified document archiving for banks and
        healthcare.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href="/cv"
          class="group inline-flex items-center gap-2 rounded-full bg-accent-700 px-6 py-3 text-sm font-semibold text-white glow-button transition hover:bg-accent-600 hover:glow-button-strong"
        >
          Read the CV
          <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
        </a>
        <a
          href="#work"
          class="glass rounded-full px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
        >
          See projects
        </a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-xs lg:mr-0">
      <div
        aria-hidden="true"
        class="absolute -inset-4 rounded-[2.5rem] bg-linear-to-br from-accent-800/25 via-accent-950/20 to-warm-900/15 blur-3xl"
      ></div>

      <figure class="glass relative rounded-[2rem] p-2">
        <Image
          src={portrait}
          alt="Luka Jerman"
          width={480}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full rounded-[1.6rem] object-cover"
        />
        <figcaption class="absolute inset-x-2 bottom-2 rounded-b-[1.6rem] bg-linear-to-t from-black/85 via-black/40 to-transparent px-5 pt-16 pb-5">
          <p class="text-xs font-semibold tracking-[0.14em] text-accent-400 uppercase">Now</p>
          <p class="mt-0.5 font-medium text-white">Working at {current.org}</p>
        </figcaption>
      </figure>

      <p class="glass absolute -top-4 right-3 flex items-center gap-2 rounded-full px-3.5 py-2 text-xs font-semibold text-white shadow-xl shadow-black/40 sm:-right-4">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full rounded-full bg-dot opacity-70 motion-safe:animate-ping"></span>
          <span class="relative inline-flex size-2 rounded-full bg-dot"></span>
        </span>
        {years}+ years in production .NET
      </p>
    </div>
  </section>

  <section aria-label="At a glance" class="mx-auto max-w-6xl px-5 sm:px-6">
    {/* flex-col-reverse puts each number above its label while the label
        stays first for screen readers; justify-end then lines the numbers up
        along the top, however many lines a label wraps to. */}
    <dl class="glass grid divide-y divide-white/5 rounded-3xl lg:grid-cols-4 lg:divide-x lg:divide-y-0">
      <div class="flex flex-col-reverse justify-end p-8">
        <dt class="mt-2 text-sm text-zinc-400">shipping production .NET</dt>
        <dd class="font-display text-5xl tracking-[0.01em] text-white uppercase">
          {years}+<span class="text-accent-500"> yrs</span>
        </dd>
      </div>
      <div class="flex flex-col-reverse justify-end p-8">
        <dt class="mt-2 text-sm text-zinc-400">domains: fisheries, manufacturing, enterprise archiving</dt>
        <dd class="font-display text-5xl tracking-[0.01em] text-white">3</dd>
      </div>
      <div class="flex flex-col-reverse justify-end p-8">
        <dt class="mt-2 text-sm text-zinc-400">script throughput in a new sandbox, 1,500 per second</dt>
        {/* A capital X, not the × sign: Anton has no ×, and the fallback
            font draws it tiny next to the numbers. */}
        <dd class="font-display text-5xl tracking-[0.01em] text-white uppercase">2<span class="text-accent-500">x</span></dd>
      </div>
      <div class="flex flex-col-reverse justify-end p-8">
        <dt class="mt-2 text-sm text-zinc-400">less time per PDF signature validation after a library rewrite</dt>
        <dd class="font-display text-5xl tracking-[0.01em] text-white">65<span class="text-warm-400">%</span></dd>
      </div>
    </dl>
  </section>

  {/* Identical copies of the list; the animation slides the track by exactly
      half, then jumps back to where it started. The second half looks the
      same as the first, so the jump is invisible and the loop runs forever.
      Each loop slides half the copies, so the duration scales with them to
      keep the speed at 45s per copy. */}
  <section aria-label="Tech stack" class="fade-x mt-20 overflow-hidden">
    <div
      class="flex w-max hover:[animation-play-state:paused] motion-safe:animate-marquee"
      style={`animation-duration:${(marqueeCopies / 2) * 45}s`}
    >
      {
        Array.from({ length: marqueeCopies }, (_, copy) => (
          <ul
            aria-hidden={copy > 0 ? 'true' : undefined}
            class="flex shrink-0 gap-3 pr-3 text-sm text-zinc-300"
          >
            {skillLogos.map((skill) => (
              <li class="flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 whitespace-nowrap">
                {skill.path ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4" fill={`#${skill.darkHex ?? skill.hex}`}>
                    <path d={skill.path} />
                  </svg>
                ) : (
                  <span aria-hidden="true" class="size-2 rounded-full" style={`background:#${skill.darkHex ?? skill.hex}`} />
                )}
                {skill.name}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  {
    projects.length > 0 && (
      <section id="work" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-28 sm:px-6">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold tracking-[0.18em] text-accent-500 uppercase">Selected work</p>
            <h2 class="mt-3 font-display text-4xl tracking-[0.01em] text-white uppercase sm:text-5xl">Things I've built</h2>
          </div>
          <a href="/projects" class="text-sm text-zinc-400 transition hover:text-white">All projects →</a>
        </div>

        <ul class="mt-12 grid gap-5 md:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard
              id={project.id}
              href={`/projects/${project.id}`}
              title={project.data.title}
              status={project.data.status}
              summary={project.data.summary}
              tags={project.data.tags}
            />
          ))}
        </ul>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 pb-28 sm:px-6">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold tracking-[0.18em] text-warm-400 uppercase">Writing</p>
            <h2 class="mt-3 font-display text-4xl tracking-[0.01em] text-white uppercase sm:text-5xl">Notes from the build</h2>
          </div>
          <a href="/blog" class="text-sm text-zinc-400 transition hover:text-white">All posts →</a>
        </div>

        <ul class="glass mt-10 divide-y divide-white/5 overflow-hidden rounded-3xl">
          {posts.map((post) => (
            <PostRow
              href={`/blog/${post.id}`}
              title={post.data.title}
              date={formatDate(post.data.date)}
              datetime={isoDate(post.data.date)}
              summary={post.data.summary}
            />
          ))}
        </ul>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-6">
    <div class="glass relative overflow-hidden rounded-[2rem] px-6 py-20 text-center sm:px-16">
      <div
        aria-hidden="true"
        class="absolute top-0 left-1/2 h-64 w-[36rem] max-w-full -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-900/30 blur-[100px]"
      ></div>

      <h2 class="relative mx-auto max-w-3xl font-display text-4xl tracking-[0.01em] text-white uppercase sm:text-6xl">
        Got a system that needs understanding before it changes?
      </h2>
      <p class="relative mx-auto mt-5 max-w-xl text-zinc-400">
        Email is the best way to reach me. I'm also on GitHub and LinkedIn.
      </p>

      <div class="relative mt-10 flex flex-wrap justify-center gap-3">
        <CopyEmail class="inline-flex items-center gap-2 rounded-full bg-accent-700 px-6 py-3 text-sm font-semibold text-white glow-button transition hover:bg-accent-600">
          {email}
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="size-4 opacity-80"
          >
            <rect x="9" y="9" width="12" height="12" rx="2" />
            <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
          </svg>
        </CopyEmail>
        {
          profiles.map(({ href, label }) => (
            <a
              href={href}
              {...external(href)}
              class="glass rounded-full px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
            >
              {label} <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
