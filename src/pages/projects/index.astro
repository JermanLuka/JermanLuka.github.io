---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import { pageTitle } from '../../lib/seo';
import { kindBadge, kindFilterLabel, kinds } from '../../lib/projects';

const projects = (
  await getCollection('projects', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => a.data.order - b.data.order);

// Filtering a single project is pointless, so the controls only appear once
// there is something to narrow down.
const tags =
  projects.length > 1
    ? [...new Set(projects.flatMap((p) => p.data.tags))].sort((a, b) =>
        a.localeCompare(b),
      )
    : [];

// The kind chips are only worth showing when more than one kind exists, and
// then only for the kinds that do.
const present = new Set(projects.map((p) => p.data.kind));
const kindOptions =
  present.size > 1
    ? kinds
        .filter((kind) => present.has(kind))
        .map((kind) => ({ value: `kind:${kind}`, label: kindFilterLabel[kind] }))
    : [];

const groups = [
  kindOptions,
  tags.map((tag) => ({ value: tag, label: tag })),
];

const emptyClass =
  'glass mt-10 rounded-3xl px-6 py-12 text-center text-sm text-zinc-400';
---

<Layout
  title={pageTitle('Projects: .NET, AI Tooling and Godot')}
  description="Projects by Luka Jerman: .NET integration architectures, an IoT hive monitoring app, AI tools for estimates and SEO, and a 3D RPG in Godot and C#."
  width="wide"
>
  <PageHeading eyebrow="Selected work" title="Projects">
    <p>Things I've built and things I'm still building.</p>
  </PageHeading>

  {
    projects.length === 0 ? (
      <p class={emptyClass}>Nothing here yet.</p>
    ) : (
      <>
        <div class="mt-10">
          <TagFilter groups={groups} label="Filter projects" />
        </div>

        <ul data-filter-list class="mt-8 grid gap-5 md:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard
              id={project.id}
              href={`/projects/${project.id}`}
              title={project.data.title}
              status={project.data.status}
              badge={kindBadge[project.data.kind]}
              summary={project.data.summary}
              tags={project.data.tags}
              filterValues={[`kind:${project.data.kind}`, ...project.data.tags]}
            />
          ))}
        </ul>

        <p data-filter-empty hidden class={emptyClass}>
          No projects with that tag.
        </p>
      </>
    )
  }
</Layout>
