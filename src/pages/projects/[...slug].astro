---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { siGithub } from 'simple-icons';
import Layout from '../../layouts/Layout.astro';
import ProseImageLinks from '../../components/ProseImageLinks.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<'projects'> };

const { project } = Astro.props;
const { Content } = await render(project);

// Blog posts documenting this project, oldest first. Empty unless the project
// names a series in its `devlog` field.
const devlog = project.data.devlog
  ? (
      await getCollection('blog', ({ data }) =>
        data.series === project.data.devlog &&
        (import.meta.env.PROD ? !data.draft : true),
      )
    ).sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0))
  : [];
---

<Layout
  title={`${project.data.title} - Luka Jerman`}
  description={project.data.summary}
>
  <article>
    <header>
      <p class="text-sm text-slate-500 dark:text-slate-400">
        <a
          href="/projects"
          class="transition-colors hover:text-slate-900 dark:hover:text-slate-100"
        >
          &larr; Projects
        </a>
      </p>

      <div class="mt-6 flex flex-wrap items-baseline justify-between gap-x-4">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
          {project.data.title}
        </h1>
        <span class="text-sm text-slate-500 dark:text-slate-400">
          {project.data.status}
        </span>
      </div>

      <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-400">
        {project.data.summary}
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
        <ul class="flex flex-wrap gap-2">
          {project.data.tags.map((tag) => (
            <li class="rounded-full border border-slate-200 px-2.5 py-0.5 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400">
              {tag}
            </li>
          ))}
        </ul>

        {project.data.repo && (
          <a
            href={project.data.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:border-slate-500 hover:text-slate-900 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500 dark:hover:text-slate-100"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={siGithub.path} />
            </svg>
            View on GitHub
          </a>
        )}
      </div>
    </header>

    <div class="prose prose-slate mt-10 max-w-none dark:prose-invert prose-headings:font-semibold prose-headings:tracking-tight prose-a:underline-offset-4">
      <Content />
    </div>

    <ProseImageLinks />

    {
      devlog.length > 0 && (
        <nav
          class="mt-14 rounded-xl border border-slate-200 p-5 dark:border-slate-800"
          aria-label={project.data.devlog}
        >
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            {project.data.devlog}
          </h2>

          <ol class="mt-4 space-y-3">
            {devlog.map((entry) => (
              <li class="flex gap-x-3 text-sm">
                <span class="shrink-0 text-slate-400 dark:text-slate-500">
                  {entry.data.part}.
                </span>
                <a
                  href={`/blog/${entry.id}`}
                  class="text-slate-600 underline decoration-slate-300 underline-offset-4 transition-colors hover:text-slate-900 hover:decoration-slate-600 dark:text-slate-400 dark:decoration-slate-700 dark:hover:text-slate-100 dark:hover:decoration-slate-400"
                >
                  {entry.data.title}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </article>
</Layout>
