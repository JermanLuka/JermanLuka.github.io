---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { siGithub } from 'simple-icons';
import Layout from '../../layouts/Layout.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import Prose from '../../components/Prose.astro';
import ProseImageLinks from '../../components/ProseImageLinks.astro';
import StatusPill from '../../components/StatusPill.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<'projects'> };

const { project } = Astro.props;
const { Content } = await render(project);

// Blog posts documenting this project, oldest first. Empty unless the project
// names a series in its `devlog` field.
const devlog = project.data.devlog
  ? (
      await getCollection('blog', ({ data }) =>
        data.series === project.data.devlog &&
        (import.meta.env.PROD ? !data.draft : true),
      )
    ).sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0))
  : [];
---

<Layout
  title={`${project.data.title} · Luka Jerman`}
  description={project.data.summary}
>
  <article>
    <header>
      <a href="/projects" class="text-sm text-zinc-400 transition-colors hover:text-white">
        &larr; Projects
      </a>

      <div class="glass mt-8 rounded-[2rem] p-2">
        <ProjectCover id={project.id} class="h-48 rounded-[1.6rem] sm:h-64" />
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <StatusPill status={project.data.status} />
        {
          project.data.kind === 'client' && (
            <span class="text-xs font-semibold tracking-[0.14em] text-zinc-500 uppercase">Client work</span>
          )
        }
      </div>

      <h1 class="mt-4 font-display text-5xl leading-[0.95] tracking-[0.01em] text-white uppercase sm:text-6xl">
        {project.data.title}
      </h1>

      <p class="mt-5 text-lg leading-relaxed text-zinc-400">{project.data.summary}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3">
        <ul class="flex flex-wrap gap-2 text-xs text-zinc-400">
          {project.data.tags.map((tag) => (
            <li class="rounded-full bg-white/5 px-2.5 py-1">{tag}</li>
          ))}
        </ul>

        {
          project.data.repo && (
            <a
              href={project.data.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="glass inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={siGithub.path} />
              </svg>
              View on GitHub
            </a>
          )
        }

        {
          project.data.website && (
            <a
              href={project.data.website}
              target="_blank"
              rel="noopener noreferrer"
              class="glass group inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10"
            >
              Visit the site
              <span aria-hidden="true" class="transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
            </a>
          )
        }
      </div>
    </header>

    <div class="mt-14 border-t border-white/5 pt-12">
      <Prose>
        <Content />
      </Prose>
    </div>

    <ProseImageLinks />

    {
      devlog.length > 0 && (
        <nav class="glass mt-16 rounded-3xl p-6 sm:p-8" aria-label={project.data.devlog}>
          <p class="text-xs font-semibold tracking-[0.18em] text-accent-500 uppercase">Devlog</p>
          <h2 class="mt-2 font-display text-2xl tracking-[0.01em] text-white uppercase">
            {project.data.devlog}
          </h2>

          <ol class="mt-5 space-y-3">
            {devlog.map((entry) => (
              <li class="flex gap-x-3">
                <span class="w-5 shrink-0 text-zinc-500">{entry.data.part}.</span>
                <a href={`/blog/${entry.id}`} class="text-zinc-300 transition-colors hover:text-accent-300">
                  {entry.data.title}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </article>
</Layout>
