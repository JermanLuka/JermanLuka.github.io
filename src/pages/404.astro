---
// GitHub Pages serves this automatically for any path that does not exist.
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';

const elsewhere = [
  { href: '/cv', label: 'CV', note: 'Where I have worked and what I work with.' },
  {
    href: '/projects',
    label: 'Projects',
    note: 'Things I have built, including a game in development.',
  },
  { href: '/blog', label: 'Blog', note: 'Notes on what I am building.' },
  { href: '/contact', label: 'Contact', note: 'How to reach me.' },
];
---

<Layout
  title="Page not found · Luka Jerman"
  description="That page does not exist."
>
  <PageHeading eyebrow="404" title="That page does not exist">
    <p>
      The link may be out of date, or I may have moved something. Either way,
      here is everything that does exist:
    </p>
  </PageHeading>

  <ul class="mt-12 grid gap-4 sm:grid-cols-2">
    {
      elsewhere.map(({ href, label, note }) => (
        <li>
          <a
            href={href}
            class="group glass block h-full rounded-3xl p-6 transition hover:-translate-y-0.5 hover:border-accent-500/30 motion-reduce:hover:translate-y-0"
          >
            <span class="flex items-center justify-between">
              <span class="font-display text-2xl tracking-[0.01em] text-white uppercase">{label}</span>
              <span aria-hidden="true" class="text-zinc-500 transition group-hover:translate-x-1 group-hover:text-white">→</span>
            </span>
            <span class="mt-2 block text-sm text-zinc-400">{note}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
