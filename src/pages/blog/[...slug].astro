---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Prose from '../../components/Prose.astro';
import ProseImageLinks from '../../components/ProseImageLinks.astro';
import { formatDate, isoDate } from '../../lib/date';

// Runs at build time: one static HTML file is produced per markdown file.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { Content } = await render(post);

// Other instalments of the same series, oldest first. Empty for a standalone post.
const series = post.data.series
  ? (
      await getCollection('blog', ({ data }) =>
        data.series === post.data.series &&
        (import.meta.env.PROD ? !data.draft : true),
      )
    ).sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0))
  : [];
---

<Layout
  title={`${post.data.title} · Luka Jerman`}
  description={post.data.summary}
  article={{ published: post.data.date }}
>
  <article>
    <header>
      <a href="/blog" class="text-sm text-zinc-400 transition-colors hover:text-white">
        &larr; Blog
      </a>

      {
        post.data.series && (
          <p class="mt-10 text-xs font-semibold tracking-[0.18em] text-accent-500 uppercase">
            {post.data.series}
            {post.data.part && ` · Part ${post.data.part}`}
          </p>
        )
      }

      <h1
        class:list={[
          'font-display text-4xl leading-[1] tracking-[0.01em] text-white uppercase sm:text-5xl',
          post.data.series ? 'mt-3' : 'mt-10',
        ]}
      >
        {post.data.title}
      </h1>

      <p class="mt-5 text-lg leading-relaxed text-zinc-400">{post.data.summary}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-zinc-500">
        <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
        {post.data.tags.length > 0 && <span aria-hidden="true">&middot;</span>}
        <ul class="flex flex-wrap gap-2 text-xs text-zinc-400">
          {post.data.tags.map((tag) => (
            <li class="rounded-full bg-white/5 px-2.5 py-1">{tag}</li>
          ))}
        </ul>
      </div>
    </header>

    <div class="mt-12 border-t border-white/5 pt-12">
      <Prose>
        <Content />
      </Prose>
    </div>

    <ProseImageLinks />

    {
      series.length > 1 && (
        <nav class="glass mt-16 rounded-3xl p-6 sm:p-8" aria-label={`All parts of ${post.data.series}`}>
          <p class="text-xs font-semibold tracking-[0.18em] text-accent-500 uppercase">Series</p>
          <h2 class="mt-2 font-display text-2xl tracking-[0.01em] text-white uppercase">
            {post.data.series}
          </h2>

          <ol class="mt-5 space-y-3">
            {series.map((entry) => (
              <li class="flex gap-x-3">
                <span class="w-5 shrink-0 text-zinc-500">{entry.data.part}.</span>
                {entry.id === post.id ? (
                  <span class="text-white">
                    {entry.data.title} <span class="text-zinc-500">(this one)</span>
                  </span>
                ) : (
                  <a href={`/blog/${entry.id}`} class="text-zinc-300 transition-colors hover:text-accent-300">
                    {entry.data.title}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </article>
</Layout>
