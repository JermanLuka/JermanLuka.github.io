---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProseImageLinks from '../../components/ProseImageLinks.astro';
import { formatDate, isoDate } from '../../lib/date';

// Runs at build time: one static HTML file is produced per markdown file.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { Content } = await render(post);

// Other instalments of the same series, oldest first. Empty for a standalone post.
const series = post.data.series
  ? (
      await getCollection('blog', ({ data }) =>
        data.series === post.data.series &&
        (import.meta.env.PROD ? !data.draft : true),
      )
    ).sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0))
  : [];
---

<Layout
  title={`${post.data.title} - Luka Jerman`}
  description={post.data.summary}
  article={{ published: post.data.date }}
>
  <article>
    <header>
      <p class="text-sm text-slate-500 dark:text-slate-400">
        <a
          href="/blog"
          class="transition-colors hover:text-slate-900 dark:hover:text-slate-100"
        >
          &larr; Blog
        </a>
      </p>

      {
        post.data.series && (
          <p class="mt-6 text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">
            {post.data.series}
            {post.data.part && ` · Part ${post.data.part}`}
          </p>
        )
      }

      <h1
        class:list={[
          'text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-100',
          post.data.series ? 'mt-2' : 'mt-6',
        ]}
      >
        {post.data.title}
      </h1>

      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-500 dark:text-slate-400">
        <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
        {post.data.tags.length > 0 && <span aria-hidden="true">&middot;</span>}
        <ul class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <li class="rounded-full border border-slate-200 px-2.5 py-0.5 text-xs dark:border-slate-800">
              {tag}
            </li>
          ))}
        </ul>
      </div>
    </header>

    <div class="prose prose-slate mt-10 max-w-none dark:prose-invert prose-headings:font-semibold prose-headings:tracking-tight prose-a:underline-offset-4">
      <Content />
    </div>

    <ProseImageLinks />

    {
      series.length > 1 && (
        <nav
          class="mt-14 rounded-xl border border-slate-200 p-5 dark:border-slate-800"
          aria-label={`All parts of ${post.data.series}`}
        >
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            {post.data.series}
          </h2>

          <ol class="mt-4 space-y-2">
            {series.map((entry) => (
              <li class="flex gap-x-3 text-sm">
                <span class="shrink-0 text-slate-400 dark:text-slate-500">
                  {entry.data.part}.
                </span>
                {entry.id === post.id ? (
                  <span class="text-slate-900 dark:text-slate-100">
                    {entry.data.title} <span class="text-slate-400">(this one)</span>
                  </span>
                ) : (
                  <a
                    href={`/blog/${entry.id}`}
                    class="text-slate-600 underline decoration-slate-300 underline-offset-4 transition-colors hover:text-slate-900 hover:decoration-slate-600 dark:text-slate-400 dark:decoration-slate-700 dark:hover:text-slate-100 dark:hover:decoration-slate-400"
                  >
                    {entry.data.title}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </article>
</Layout>
