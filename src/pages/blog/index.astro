---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import PostRow from '../../components/PostRow.astro';
import TagFilter from '../../components/TagFilter.astro';
import { formatDate, isoDate } from '../../lib/date';

// Drafts are hidden in a production build but visible while running `npm run dev`.
const posts = (
  await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Filtering a single post is pointless, so the controls only appear once
// there is something to narrow down.
const tags =
  posts.length > 1
    ? [...new Set(posts.flatMap((p) => p.data.tags))].sort((a, b) =>
        a.localeCompare(b),
      )
    : [];

const emptyClass =
  'glass mt-10 rounded-3xl px-6 py-12 text-center text-sm text-zinc-400';
---

<Layout
  title="Blog · Luka Jerman"
  description="Notes on what I am building and learning."
  width="wide"
>
  <PageHeading eyebrow="Writing" title="Notes from the build">
    <p>Notes on what I'm building and whatever I'm figuring out.</p>
  </PageHeading>

  {
    posts.length === 0 ? (
      <p class={emptyClass}>No posts yet.</p>
    ) : (
      <>
        <div class="mt-10">
          <TagFilter
            groups={[tags.map((tag) => ({ value: tag, label: tag }))]}
            label="Filter posts by tag"
          />
        </div>

        {/* Each post gets its own panel, rather than sharing one, so hiding
            some with the filter never leaves a stray divider behind. */}
        <ul data-filter-list class="mt-8 space-y-4">
          {posts.map((post) => (
            <PostRow
              class="glass overflow-hidden rounded-3xl"
              href={`/blog/${post.id}`}
              title={post.data.title}
              date={formatDate(post.data.date)}
              datetime={isoDate(post.data.date)}
              badge={
                post.data.series
                  ? `${post.data.series}${post.data.part ? ` · Part ${post.data.part}` : ''}`
                  : undefined
              }
              summary={post.data.summary}
              tags={post.data.tags}
              filterValues={post.data.tags}
            />
          ))}
        </ul>

        <p data-filter-empty hidden class={emptyClass}>
          No posts with that tag.
        </p>
      </>
    )
  }
</Layout>
