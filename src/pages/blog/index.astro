---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EntryCard from '../../components/EntryCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import { formatDate, isoDate } from '../../lib/date';

// Drafts are hidden in a production build but visible while running `npm run dev`.
const posts = (
  await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Filtering a single post is pointless, so the controls only appear once
// there is something to narrow down.
const tags =
  posts.length > 1
    ? [...new Set(posts.flatMap((p) => p.data.tags))].sort((a, b) =>
        a.localeCompare(b),
      )
    : [];
---

<Layout
  title="Blog - Luka Jerman"
  description="Notes on what I am building and learning."
>
  <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
    Blog
  </h1>

  <p class="mt-5 leading-relaxed text-slate-600 dark:text-slate-400">
    Notes on what I'm building and whatever I'm figuring out.
  </p>

  {
    posts.length === 0 ? (
      <p class="mt-10 rounded-md border border-dashed border-slate-300 px-5 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
        No posts yet.
      </p>
    ) : (
      <>
        <div class="mt-8">
          <TagFilter
            groups={[tags.map((tag) => ({ value: tag, label: tag }))]}
            label="Filter posts by tag"
          />
        </div>

        <ul data-filter-list class="mt-6 space-y-4">
          {posts.map((post) => (
            <EntryCard
              href={`/blog/${post.id}`}
              title={post.data.title}
              meta={formatDate(post.data.date)}
              datetime={isoDate(post.data.date)}
              badge={
                post.data.series
                  ? `${post.data.series}${post.data.part ? ` · Part ${post.data.part}` : ''}`
                  : undefined
              }
              summary={post.data.summary}
              tags={post.data.tags}
            />
          ))}
        </ul>

        <p
          data-filter-empty
          hidden
          class="mt-6 rounded-md border border-dashed border-slate-300 px-5 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400"
        >
          No posts with that tag.
        </p>
      </>
    )
  }
</Layout>
