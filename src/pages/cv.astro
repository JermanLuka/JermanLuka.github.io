---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import StatusPill from '../components/StatusPill.astro';
import { education, experience, intro, skills, yearsOfExperience } from '../lib/cv';
import { kindBadge } from '../lib/projects';
import { pageTitle } from '../lib/seo';

const years = yearsOfExperience();

// Client projects belong on the CV; internal tools and personal projects stay
// on /projects. The text comes from each project's markdown, so it lives in
// one place.
const clientProjects = (
  await getCollection('projects', ({ data }) =>
    data.kind === 'client' && (import.meta.env.PROD ? !data.draft : true),
  )
).sort((a, b) => a.data.order - b.data.order);

// Each section is a label column and a content column on wide screens, and
// simply stacks on narrow ones.
const sectionClass = 'mt-20 grid gap-6 lg:grid-cols-[13rem_1fr] lg:gap-12';
const labelClass =
  'font-display text-3xl tracking-[0.01em] text-white uppercase lg:sticky lg:top-24 lg:self-start';
const chipClass = 'rounded-full bg-white/5 px-2.5 py-1 text-xs text-zinc-400';
---

<Layout
  title={pageTitle('CV: Backend & Integration Engineer')}
  description={`CV of Luka Jerman, software engineer: ${years}+ years of backend and integration work in C#, .NET and SQL Server across document management, IoT and ERP.`}
  width="wide"
>
  <PageHeading eyebrow="Curriculum vitae" title="Backend & integration engineer">
    <p>
      Software engineer. {years}+ years of backend and integration work across
      vessel monitoring, ERP and enterprise document management.
    </p>
  </PageHeading>

  <section class={sectionClass}>
    <h2 class={labelClass}>About</h2>
    <div class="max-w-3xl space-y-5 text-lg leading-relaxed text-zinc-300">
      {
        intro.map((block) =>
          Array.isArray(block) ? (
            <ul class="space-y-2 text-zinc-400">
              {block.map((item) => (
                <li class="relative pl-5">
                  <span aria-hidden="true" class="absolute top-[0.7em] left-0 size-1.5 rounded-full bg-dot/80" />
                  {item}
                </li>
              ))}
            </ul>
          ) : (
            <p>{block}</p>
          ),
        )
      }
    </div>
  </section>

  <section class={sectionClass}>
    <h2 class={labelClass}>Experience</h2>

    <ol class="space-y-5">
      {
        experience.map((job, index) => (
          <li class="glass rounded-3xl p-6 sm:p-8">
            <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
              <div>
                <h3 class="font-display text-3xl tracking-[0.01em] text-white uppercase">{job.org}</h3>
                <p class="mt-1 text-sm text-zinc-400">
                  {job.role} &middot; {job.focus}
                </p>
              </div>
              <p
                class:list={[
                  'inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold whitespace-nowrap ring-1',
                  index === 0
                    ? 'bg-accent-500/10 text-accent-300 ring-accent-500/25'
                    : 'bg-white/5 text-zinc-300 ring-white/10',
                ]}
              >
                {index === 0 && <span class="size-1.5 rounded-full bg-dot" />}
                {job.period}
              </p>
            </div>

            <p class="mt-5 leading-relaxed text-zinc-300">{job.blurb}</p>

            <ul class="mt-5 space-y-3 leading-relaxed text-zinc-400">
              {job.notes.map((note) => (
                <li class="relative pl-5">
                  <span aria-hidden="true" class="absolute top-[0.7em] left-0 size-1.5 rounded-full bg-dot/80" />
                  {note}
                </li>
              ))}
            </ul>

            <ul class="mt-6 flex flex-wrap gap-2">
              {job.stack.map((item) => (
                <li class={chipClass}>{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  {
    clientProjects.length > 0 && (
      <section class={sectionClass}>
        <h2 class={labelClass}>Projects</h2>

        <ol class="space-y-5">
          {clientProjects.map((project) => (
            <li class="glass rounded-3xl p-6 sm:p-8">
              <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
                <div>
                  <h3 class="font-display text-3xl tracking-[0.01em] text-white uppercase">{project.data.title}</h3>
                  <p class="mt-1 text-sm text-zinc-400">Freelance &middot; {kindBadge[project.data.kind]}</p>
                </div>
                <StatusPill status={project.data.status} />
              </div>

              <p class="mt-5 leading-relaxed text-zinc-300">{project.data.summary}</p>

              <ul class="mt-6 flex flex-wrap gap-2">
                {project.data.tags.map((tag) => (
                  <li class={chipClass}>{tag}</li>
                ))}
              </ul>

              <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
                <a href={`/projects/${project.id}`} class="text-accent-300 transition hover:text-white">
                  Project page <span aria-hidden="true">→</span>
                </a>
                {project.data.website && (
                  <a href={project.data.website} class="text-zinc-400 transition hover:text-white">
                    {new URL(project.data.website).host} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class={sectionClass}>
    <h2 class={labelClass}>Education</h2>

    <ol class="grid gap-5 md:grid-cols-2">
      {
        education.map((item) => (
          <li class="glass rounded-3xl p-6 sm:p-8">
            <p class="text-xs font-semibold tracking-[0.14em] text-accent-400 uppercase">{item.period}</p>
            <h3 class="mt-3 font-semibold text-white">{item.what}</h3>
            <p class="mt-1 text-sm text-zinc-400">{item.org}</p>
            <p class="mt-4 leading-relaxed text-zinc-400">{item.note}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class={sectionClass}>
    <h2 class={labelClass}>Skills</h2>

    <dl class="grid gap-5 sm:grid-cols-2">
      {
        skills.map((skill) => (
          <div class="glass rounded-3xl p-6">
            <dt class="text-xs font-semibold tracking-[0.14em] text-accent-400 uppercase">{skill.group}</dt>
            <dd class="mt-4">
              <ul class="flex flex-wrap gap-2">
                {skill.items.map((item) => (
                  <li class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-sm text-zinc-200">
                    {item}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Layout>
