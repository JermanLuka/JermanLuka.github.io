---
import Layout from '../layouts/Layout.astro';

// A Cloudflare Email Routing alias, not a real mailbox. It forwards to my
// personal inbox, which never appears on the site. If it ever attracts too much
// spam, deleting the alias and creating another one is the whole fix.
const email = 'hi@lukajerman.dev';

const profiles = [
  {
    label: 'GitHub',
    value: 'JermanLuka',
    href: 'https://github.com/JermanLuka',
  },
  {
    label: 'LinkedIn',
    value: 'luka-jerman',
    href: 'https://www.linkedin.com/in/luka-jerman-12046442b/',
  },
];

const linkClass =
  'underline decoration-slate-300 underline-offset-4 transition-colors hover:decoration-slate-600 dark:decoration-slate-700 dark:hover:decoration-slate-400';
---

<Layout
  title="Contact - Luka Jerman"
  description="How to get in touch with Luka Jerman."
>
  <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
    Contact
  </h1>

  <p class="mt-5 leading-relaxed text-slate-600 dark:text-slate-400">
    Email is the best way to reach me. I'm also on GitHub and LinkedIn.
  </p>

  <ul class="mt-10 space-y-6">
    <li class="flex flex-wrap items-baseline gap-x-4">
      <span class="w-20 shrink-0 text-sm text-slate-500 dark:text-slate-400">
        Email
      </span>
      <span class="flex items-center gap-2">
        <span>{email}</span>
        <a
          href={`mailto:${email}`}
          aria-label={`Send an email to ${email}`}
          title="Compose an email"
          class="text-slate-400 transition-colors hover:text-slate-900 dark:text-slate-500 dark:hover:text-slate-100"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="h-4 w-4"
          >
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m2 7 10 6 10-6" />
          </svg>
        </a>
      </span>
    </li>

    {
      profiles.map((profile) => (
        <li class="flex flex-wrap items-baseline gap-x-4">
          <span class="w-20 shrink-0 text-sm text-slate-500 dark:text-slate-400">
            {profile.label}
          </span>
          <a
            href={profile.href}
            target="_blank"
            rel="me noopener noreferrer"
            class={linkClass}
          >
            {profile.value}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
