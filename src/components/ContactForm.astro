---
// The contact form. It posts to the Cloudflare Worker in worker/, which runs
// the spam check and emails me. Turnstile, the spam check, needs JavaScript,
// so the contact page keeps the plain email address below it for anyone
// without.
import { contactEndpoint, turnstileSiteKey } from '../lib/contact';

const labelClass = 'text-sm font-medium text-zinc-300';
const inputClass =
  'mt-2 block w-full rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3 text-white outline-none transition focus:border-accent-500/60 focus:bg-white/[0.05] focus:ring-4 focus:ring-accent-500/15';
---

<div class="glass relative overflow-hidden rounded-3xl p-6 sm:p-8">
  <div aria-hidden="true" class="absolute inset-x-10 top-0 h-px bg-linear-to-r from-transparent via-accent-500 to-transparent"></div>

  <form data-contact-form action={contactEndpoint} method="post" class="relative">
    <div class="grid gap-5 sm:grid-cols-2">
      <label class="block">
        <span class={labelClass}>Full name</span>
        <input name="name" type="text" required maxlength="100" autocomplete="name" class={inputClass} />
      </label>
      <label class="block">
        <span class={labelClass}>Email address</span>
        <input name="email" type="email" required maxlength="254" autocomplete="email" class={inputClass} />
      </label>
      <label class="block sm:col-span-2">
        <span class={labelClass}>Message</span>
        <textarea name="message" required maxlength="5000" rows="6" class={`${inputClass} resize-y`}></textarea>
      </label>
    </div>

    {/* The honeypot. Off screen, out of the tab order and ignored by autofill,
        so a person never fills it in and anything that does is a bot. */}
    <div aria-hidden="true" class="absolute -left-[9999px] size-px overflow-hidden">
      <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <button
        type="submit"
        class="group inline-flex cursor-pointer items-center gap-2 rounded-full bg-accent-700 px-6 py-3 text-sm font-semibold text-white glow-button transition hover:bg-accent-600 hover:glow-button-strong disabled:cursor-wait disabled:opacity-60"
      >
        Send
        <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
      </button>
      <p data-contact-status role="status" class="text-sm text-zinc-400 data-error:text-accent-400"></p>

      {/* Turnstile adds its token to the form as a hidden field. With
          interaction-only it stays invisible unless it needs a click. */}
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" data-appearance="interaction-only"></div>
    </div>
  </form>

  <div data-contact-sent hidden tabindex="-1" class="relative py-8 text-center outline-none">
    <span class="mx-auto flex size-12 items-center justify-center rounded-full bg-accent-700 text-white glow-button">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m5 12.5 4.5 4.5L19 7.5" />
      </svg>
    </span>
    <p class="mt-5 font-display text-3xl tracking-[0.01em] text-white uppercase">Message sent</p>
    <p class="mt-2 text-zinc-400">Thanks for writing. I'll reply by email.</p>
  </div>
</div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { showToast } from '../lib/toast';

  type Turnstile = { reset(): void };
  type Reply = { ok: true } | { error: string };

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const sent = document.querySelector<HTMLElement>('[data-contact-sent]');
  const status = form?.querySelector<HTMLElement>('[data-contact-status]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  const fail = (message: string) => {
    if (!status) return;
    status.dataset.error = '';
    status.textContent = message;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !button || !sent) return;

    button.disabled = true;
    delete status.dataset.error;
    status.textContent = 'Sending…';

    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const reply = (await response.json().catch(() => null)) as Reply | null;

      if (!reply || 'error' in reply) {
        fail(reply?.error ?? 'Something went wrong. Please try again, or email me instead.');
        return;
      }

      form.hidden = true;
      sent.hidden = false;
      sent.focus();
      showToast('Message sent');
    } catch {
      // fetch only throws when no reply came back at all: offline, or the
      // Worker is unreachable.
      fail("Couldn't reach the server. Check your connection, or email me instead.");
    } finally {
      button.disabled = false;
      // A Turnstile token works once, so fetch a fresh one for another try.
      (window as Window & { turnstile?: Turnstile }).turnstile?.reset();
    }
  });
</script>
