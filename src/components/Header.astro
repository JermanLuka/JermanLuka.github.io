---
import AccentMenu from './AccentMenu.astro';
import LogoMark from './LogoMark.astro';

const links = [
  { href: '/cv', label: 'CV' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
];

// Normalize away any trailing slash so "/cv/" still matches "/cv". At build
// time the path is "/cv.html", which still starts with "/cv".
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path.startsWith(href);
---

{/* Frosted rather than solid, so the aurora shows through as it scrolls under. */}
<header class="sticky top-0 z-40 border-b border-white/5 bg-page/55 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-5 sm:px-6">
    <a href="/" aria-label="Luka Jerman, home" class="flex items-center gap-2.5 text-white transition-opacity hover:opacity-85">
      <LogoMark class="size-8 text-accent-700" />
      <span class="hidden font-display text-lg tracking-[0.01em] uppercase sm:inline">Luka Jerman</span>
    </a>

    <nav aria-label="Main">
      <ul class="flex items-center gap-0.5 text-sm sm:gap-1">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-2.5 py-1.5 transition hover:bg-white/5 hover:text-white sm:px-3',
                  isActive(href) ? 'bg-white/5 text-white' : 'text-zinc-400',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact"
        aria-current={isActive('/contact') ? 'page' : undefined}
        class="rounded-full bg-accent-700 px-4 py-1.5 text-sm font-semibold text-white transition hover:bg-accent-600"
      >
        Contact
      </a>
      {/* No room beside the nav on a phone; the footer carries it there. */}
      <div class="hidden sm:flex">
        <AccentMenu compact />
      </div>
    </div>
  </div>
</header>
