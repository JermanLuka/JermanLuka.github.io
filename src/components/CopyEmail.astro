---
// A button that copies the email address and confirms it with the toast. It
// replaces a mailto: link, which only works when a mail app is installed. Most
// people write from webmail, so for them the link did nothing.
//
// The look is up to the page: pass the classes, and the content as children.
import { email } from '../lib/contact';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-copy-email={email}
  aria-label={`Copy email address ${email}`}
  class:list={['cursor-pointer', className]}
>
  <slot />
</button>

<script>
  import { showToast } from '../lib/toast';

  for (const button of document.querySelectorAll<HTMLElement>('[data-copy-email]')) {
    button.addEventListener('click', async () => {
      const email = button.dataset.copyEmail ?? '';
      try {
        await navigator.clipboard.writeText(email);
        showToast('Email copied');
      } catch {
        // The browser can refuse clipboard access. Show the address instead,
        // so it can still be copied by hand.
        showToast(`Couldn't copy it. The address is ${email}`, 6000);
      }
    });
  }
</script>
