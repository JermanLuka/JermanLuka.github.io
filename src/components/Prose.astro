---
// Rendered markdown (blog posts, project write ups) in the site's dark look.
// Section headings take the display face; Anton has a single weight, so they
// are reset to normal or the browser would fake a bold one.
---

<div
  class="prose prose-lg prose-zinc prose-invert max-w-none
    prose-headings:text-white
    prose-h2:font-display prose-h2:text-3xl prose-h2:font-normal prose-h2:tracking-[0.01em] prose-h2:uppercase
    prose-p:text-zinc-300 prose-li:text-zinc-300 prose-strong:text-white
    prose-a:text-accent-300 prose-a:decoration-accent-500/40 prose-a:underline-offset-4 hover:prose-a:decoration-accent-400
    prose-blockquote:border-accent-500/60 prose-blockquote:text-zinc-400
    prose-code:text-warm-200 prose-hr:border-white/10
    [&_li::marker]:text-dot"
>
  <slot />
</div>
