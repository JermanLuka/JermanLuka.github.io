---
// The site's notification: a small pill at the bottom of the screen, shown
// with showToast() from src/lib/toast.ts. It sits in the page from the start,
// empty and invisible, because a screen reader only announces changes to a
// live region it already knows about.
---

<div
  data-toast
  role="status"
  class="toast pointer-events-none fixed inset-x-0 bottom-6 z-50 flex justify-center px-5"
>
  <p class="flex items-center gap-2.5 rounded-full border border-white/10 bg-page px-4 py-2.5 text-sm font-medium text-white shadow-xl shadow-black/50">
    <span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-dot"></span>
    <span data-toast-text></span>
  </p>
</div>

<style>
  .toast {
    opacity: 0;
    translate: 0 0.5rem;
    transition:
      opacity 200ms ease,
      translate 200ms ease;
  }

  .toast[data-open] {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .toast {
      translate: none;
    }
  }
</style>
