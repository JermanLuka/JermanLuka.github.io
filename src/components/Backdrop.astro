---
// Ambient background: procedurally generated lightning that slowly crawls in
// from the edges, holds, then fades. Decorative only - sits behind all content
// and ignores pointer events.
//
// Geometry is generated at build time from a fixed seed, so the shapes are
// irregular like real lightning but identical on every build and every visit.

/** Small deterministic PRNG - same seed always yields the same bolt. */
function mulberry32(seed: number) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

type Segment = {
  d: string;
  width: number;
  /** Fraction of the cycle at which this segment starts drawing. */
  start: number;
};

type BoltSpec = {
  x: number;
  y: number;
  /** Heading in radians. 0 points right, PI points left, positive is downward. */
  angle: number;
  length: number;
  steps: number;
  width: number;
  seed: number;
  /** Seconds for one full strike-and-reset cycle. */
  duration: number;
  /** Negative, so the bolt is already mid-cycle on first paint. */
  delay: number;
  tint: string;
};

/** Fraction of a cycle across which forks are staggered behind the main channel. */
const DRAW_SPAN = 0.18;

function generateBolt(spec: BoltSpec): Segment[] {
  const rand = mulberry32(spec.seed);
  const segments: Segment[] = [];

  function walk(
    x: number,
    y: number,
    baseAngle: number,
    length: number,
    steps: number,
    width: number,
    depth: number,
    start: number,
    span: number,
  ) {
    const points: [number, number][] = [[x, y]];
    const stepLength = length / steps;
    let cx = x;
    let cy = y;

    for (let i = 0; i < steps; i++) {
      // Jitter around the base heading rather than random-walking the heading
      // itself - that keeps the bolt erratic but still travelling one way.
      const angle = baseAngle + (rand() - 0.5) * 1.25;
      const reach = stepLength * (0.55 + rand() * 0.9);

      cx += Math.cos(angle) * reach;
      cy += Math.sin(angle) * reach;
      points.push([cx, cy]);

      // Fork off a shorter, thinner branch that starts drawing once the main
      // channel has reached this point.
      const canBranch = depth < 2 && i > 1 && i < steps - 2;
      if (canBranch && rand() < 0.24) {
        const side = rand() < 0.5 ? -1 : 1;
        walk(
          cx,
          cy,
          baseAngle + side * (0.45 + rand() * 0.7),
          length * (0.25 + rand() * 0.3),
          Math.max(5, Math.round(steps * 0.45)),
          width * 0.55,
          depth + 1,
          start + (i / steps) * span,
          span * 0.45,
        );
      }
    }

    const d =
      'M' + points.map(([px, py]) => `${px.toFixed(1)} ${py.toFixed(1)}`).join(' L ');

    segments.push({ d, width, start });
  }

  walk(spec.x, spec.y, spec.angle, spec.length, spec.steps, spec.width, 0, 0, DRAW_SPAN);
  return segments;
}

// Placement is generated too, so strikes scatter across both gutters instead of
// sitting at a few hand-picked spots. Seeded, so it stays stable build to build.
const BOLT_COUNT = 3;
const place = mulberry32(913377);

const specs: BoltSpec[] = Array.from({ length: BOLT_COUNT }, (_, i) => {
  // Alternate sides so one gutter never ends up crowded.
  const fromLeft = i % 2 === 0;
  const spread = 0.2 + place() * 0.75; // how steeply it travels downward
  const duration = 30 + place() * 24;

  return {
    x: fromLeft ? -40 : 1240,
    y: 20 + place() * 660,
    angle: fromLeft ? spread : Math.PI - spread,
    length: 430 + place() * 320,
    steps: 16 + Math.round(place() * 8),
    width: 1.3 + place() * 0.9,
    seed: Math.floor(place() * 1e9),
    duration,
    // Scatter the starting phases so they never strike in unison.
    delay: -place() * duration,
    tint: place() < 0.5 ? 'rgb(56 189 248)' : 'rgb(129 140 248)',
  };
});

const bolts = specs.map((spec) => ({
  timing:
    `--tint:${spec.tint};animation-duration:${spec.duration.toFixed(2)}s;` +
    `animation-delay:${spec.delay.toFixed(2)}s`,
  // Handed to the script below so it can recompute the delays against the
  // clock. `phase` is the scatter that keeps the bolts from striking together,
  // expressed as a positive offset into the cycle.
  duration: spec.duration.toFixed(2),
  phase: (-spec.delay).toFixed(2),
  segments: generateBolt(spec).map((seg) => ({
    ...seg,
    // Forks wait until the main channel has crawled past their origin.
    timing:
      `animation-duration:${spec.duration.toFixed(2)}s;` +
      `animation-delay:${(spec.delay + seg.start * spec.duration).toFixed(2)}s`,
  })),
}));
---

<div class="backdrop" aria-hidden="true">
  <svg
    class="bolts"
    viewBox="0 0 1200 800"
    preserveAspectRatio="xMidYMid slice"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="miter"
  >
    {
      bolts.map((bolt) => (
        <g
          class="bolt"
          style={bolt.timing}
          data-duration={bolt.duration}
          data-phase={bolt.phase}
        >
          {/* Wide, blurred, coloured halo. */}
          <g class="halo">
            {bolt.segments.map((seg) => (
              <path
                d={seg.d}
                pathLength="1"
                stroke-width={(seg.width * 4).toFixed(2)}
                style={seg.timing}
                data-offset={seg.start.toFixed(4)}
              />
            ))}
          </g>

          {/* Thin white-hot core on top. */}
          <g class="core">
            {bolt.segments.map((seg) => (
              <path
                d={seg.d}
                pathLength="1"
                stroke-width={seg.width.toFixed(2)}
                style={seg.timing}
                data-offset={seg.start.toFixed(4)}
              />
            ))}
          </g>
        </g>
      ))
    }
  </svg>
</div>

{/*
  Anchors the animations to wall-clock time instead of page-load time.

  Every navigation is a fresh document, so the SVG is rebuilt and its CSS
  animations start from frame zero - a bolt caught mid-strike snaps back to
  nothing. Deriving each delay from the clock instead means the storm is a
  function of *when you are*, not *when the page loaded*, so a rebuilt SVG
  picks up exactly where the previous page left off.

  `is:inline` because this must run before the first paint; a bundled module
  script is deferred and would let one frame of the reset state through.
  Without JavaScript the baked-in delays still apply and the storm still runs -
  it just restarts on navigation, which is the behaviour we had before.
*/}
<script is:inline>
  (() => {
    const now = Date.now() / 1000;

    for (const bolt of document.querySelectorAll('.backdrop .bolt')) {
      const duration = Number(bolt.dataset.duration);
      if (!duration) continue;

      // Where this bolt sits in its own cycle right now. The stored phase is
      // the per-bolt scatter that stops them striking in unison.
      const delay = -((now + Number(bolt.dataset.phase)) % duration);
      bolt.style.animationDelay = `${delay.toFixed(2)}s`;

      // Forks keep their stagger behind the main channel, measured from the
      // group's new delay rather than from zero.
      for (const path of bolt.querySelectorAll('path')) {
        const offset = Number(path.dataset.offset) * duration;
        path.style.animationDelay = `${(delay + offset).toFixed(2)}s`;
      }
    }
  })();
</script>

<style>
  /* Content sits in a centred max-w-2xl (42rem) column. Mask that band out of
     the backdrop so bolts fade away before they reach the text rather than
     crawling behind it. Below ~56rem the column fills the screen and the mask
     hides the bolts entirely, which is what we want on narrow viewports. */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    pointer-events: none;

    --gutter: 25rem; /* half the content column, plus breathing room */
    --fade: 6rem; /* soft edge either side */

    -webkit-mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(50% - var(--gutter) - var(--fade)),
      transparent calc(50% - var(--gutter)),
      transparent calc(50% + var(--gutter)),
      #000 calc(50% + var(--gutter) + var(--fade)),
      #000 100%
    );
    mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(50% - var(--gutter) - var(--fade)),
      transparent calc(50% - var(--gutter)),
      transparent calc(50% + var(--gutter)),
      #000 calc(50% + var(--gutter) + var(--fade)),
      #000 100%
    );
  }

  .bolts {
    width: 100%;
    height: 100%;
  }

  /* Duration and delay come from inline styles, computed in the frontmatter. */
  .bolt {
    --tint: rgb(56 189 248);
    opacity: 0;
    will-change: opacity;
    animation-name: bolt-fade;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  /* Blur once per group rather than per path - far cheaper. */
  .halo {
    stroke: var(--tint);
    opacity: 0.5;
    filter: blur(7px);
  }

  .core {
    stroke: rgb(241 249 255);
    opacity: 0.45;
  }

  /* pathLength="1" normalizes every path, so one dash rule covers all of them. */
  .bolt path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation-name: strike;
    animation-timing-function: ease-out;
    animation-iteration-count: infinite;
  }

  /* Draw the channel in, hold it, then reset while invisible. */
  @keyframes strike {
    0% {
      stroke-dashoffset: 1;
    }
    28% {
      stroke-dashoffset: 0;
    }
    46% {
      stroke-dashoffset: 0;
    }
    47%,
    100% {
      stroke-dashoffset: 1;
    }
  }

  /* Fade runs on the parent group so the dash reset happens out of sight.
     The dips around 20-30% read as the flicker of a real return stroke. */
  @keyframes bolt-fade {
    0% {
    opacity: 0;
    }
    8% {
    opacity: 0.2;
    }
    34% {
    opacity: 0.19;
    }
    46% {
    opacity: 0;
    }
    100% {
    opacity: 0;
    }
  }
  /* The halo is cut harder than the core on purpose. Scaling both by the same
     factor looks wrong: a hairline core disappears long before a wide blurred
     band does, so equal cuts leave nothing but haze. */
  :global([data-theme='dark']) .core {
    opacity: 0.34;
  }
  :global([data-theme='dark']) .halo {
    opacity: 0.16;
    filter: blur(6px);
  }

  /* Light mode needs different colours, not just more of them. The core is
     near-white, which is invisible on a white page however high the opacity
     goes, so it becomes a deep blue and the halo darkens to match. The bolts
     read as ink on paper rather than as light in the dark. */
  :global([data-theme='light']) .bolt {
    --tint: rgb(14 116 144);
  }
  :global([data-theme='light']) .core {
    stroke: rgb(12 74 110);
    opacity: 0.55;
  }
  :global([data-theme='light']) .halo {
    opacity: 0.4;
    filter: blur(6px);
  }

  /* Motion is decorative - leave the bolts drawn but still. */
  @media (prefers-reduced-motion: reduce) {
    .bolt,
    .bolt path {
      animation: none;
    }
    .bolt {
    opacity: 0.1;
    }
    .bolt path {
      stroke-dashoffset: 0;
    }
  }
</style>
