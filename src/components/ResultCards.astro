---
// The two results under the home page hero, real numbers from the CV. Each
// card says what the work was, shows the before and after as bars on the same
// scale, then the check that the speed-up didn't cost anything.

type Bar = {
  label: string;
  value: string;
  /** Bar length, as a percentage of the track. */
  width: number;
  /** The new result: drawn in the accent instead of grey. */
  accent?: boolean;
};

type Result = {
  title: string;
  number: string;
  text: string;
  summary: string;
  bars: Bar[];
  check: { label: string; text: string };
};

const results: Result[] = [
  {
    title: 'PDF signature validation',
    number: '2.9',
    text: 'faster',
    summary: 'Rewrote the PDF signing library of a document archive used by banks and healthcare providers.',
    bars: [
      { label: 'Old library', value: '1,053 ms', width: 100 },
      { label: 'My rewrite', value: '363 ms', width: (363 / 1053) * 100, accent: true },
    ],
    check: { label: 'Results', text: 'Identical to the old library' },
  },
  {
    title: 'Script sandbox, two instances',
    number: '2',
    text: 'throughput',
    summary: "Helped rebuild the same platform's script sandbox. I owned the gRPC service and its protocol to the workers.",
    bars: [
      { label: 'Old sandbox', value: '750/s', width: 50 },
      { label: 'New sandbox', value: '1,500/s', width: 100, accent: true },
    ],
    check: { label: 'Isolation', text: "Scripts can't reach the host" },
  },
];
---

<ul class="grid gap-5 md:grid-cols-2">
  {
    results.map((result) => (
      <li class="glass relative flex flex-col overflow-hidden rounded-3xl p-6 sm:p-8">
        {/* A lit top edge in the accent. */}
        <div aria-hidden="true" class="absolute inset-x-10 top-0 h-px bg-linear-to-r from-transparent via-accent-500 to-transparent" />

        <p class="text-xs font-semibold tracking-[0.14em] text-accent-400 uppercase">{result.title}</p>
        {/* A capital X, not the × sign: Anton has no ×. */}
        <p class="mt-3 font-display text-5xl leading-tight tracking-[0.01em] text-white uppercase">
          {result.number}<span class="text-accent-500">x</span> {result.text}
        </p>
        <p class="mt-2 text-sm leading-relaxed text-pretty text-zinc-400">{result.summary}</p>

        {/* mt-auto lines the bars up across both cards when one summary wraps
            to more lines than the other. */}
        <div class="mt-auto space-y-2 pt-6 text-sm">
          {result.bars.map((bar) => (
            <div class="grid grid-cols-[6.5rem_4.5rem_1fr] items-center gap-3 sm:grid-cols-[7rem_5rem_1fr]">
              <span class="text-zinc-500">{bar.label}</span>
              <span class:list={['text-right tabular-nums', bar.accent ? 'font-medium text-white' : 'text-zinc-300']}>{bar.value}</span>
              <span aria-hidden="true" class="h-2 overflow-hidden rounded-sm bg-white/5">
                <span
                  class:list={[
                    'block h-full',
                    bar.accent ? 'bg-accent-500 shadow-[0_0_12px_var(--color-accent-500)]' : 'bg-zinc-600',
                  ]}
                  style={`width:${bar.width}%`}
                />
              </span>
            </div>
          ))}

          <div class="grid grid-cols-[6.5rem_1fr] items-center gap-3 sm:grid-cols-[7rem_1fr]">
            <span class="text-zinc-500">{result.check.label}</span>
            <span class="flex items-center gap-1.5 text-zinc-200">
              {result.check.text}
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="size-3.5 shrink-0 text-accent-400"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m5 12.5 4.5 4.5L19 7.5" />
              </svg>
            </span>
          </div>
        </div>
      </li>
    ))
  }
</ul>
