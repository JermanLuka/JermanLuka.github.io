---
// Two-state theme control. Dark is the design's default and light is the
// opt-out, stored in localStorage so it survives a reload.
//
// The button ships with no `hidden` attribute because the page is already dark
// server-side: without JavaScript the control simply does nothing visible, and
// hiding it would be the bigger surprise on a site that renders fine either way.
// The icon shows what a click will switch *to*, which is the convention people
// expect from a single-button toggle.
---

<button type="button" data-theme-toggle class="theme-toggle" aria-label="Switch to light mode">
  <!-- Sun: shown while dark, meaning "switch to light" -->
  <svg data-icon="light" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    />
  </svg>

  <!-- Moon: shown while light, meaning "switch to dark" -->
  <svg data-icon="dark" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<script>
  const button = document.querySelector('[data-theme-toggle]');

  if (button) {
    const root = document.documentElement;

    function apply(theme) {
      root.dataset.theme = theme;
      root.style.colorScheme = theme;

      const next = theme === 'dark' ? 'light' : 'dark';
      button.setAttribute('aria-label', `Switch to ${next} mode`);
      button.setAttribute('title', `Switch to ${next} mode`);
    }

    // The inline script in the head already set this before paint; read it back
    // rather than deciding again, so the two can never disagree.
    apply(root.dataset.theme === 'light' ? 'light' : 'dark');

    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      apply(next);
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2rem;
    width: 2rem;
    border-radius: 9999px;
    color: rgb(100 116 139);
    cursor: pointer;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .theme-toggle:hover {
    color: rgb(15 23 42);
    background-color: rgb(241 245 249);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid rgb(100 116 139);
    outline-offset: 2px;
  }

  .theme-toggle svg {
    height: 1.05rem;
    width: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: none;
  }

  /* Show the icon for the theme a click would switch to. */
  :global([data-theme='dark']) .theme-toggle svg[data-icon='light'],
  :global([data-theme='light']) .theme-toggle svg[data-icon='dark'] {
    display: block;
  }

  :global([data-theme='dark']) .theme-toggle {
    color: rgb(148 163 184);
  }

  :global([data-theme='dark']) .theme-toggle:hover {
    color: rgb(241 245 249);
    background-color: rgb(30 41 59);
  }
</style>
