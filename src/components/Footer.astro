---
import { getCollection } from 'astro:content';
import { siGithub, siRss } from 'simple-icons';
import AccentMenu from './AccentMenu.astro';
import CopyEmail from './CopyEmail.astro';
import LogoMark from './LogoMark.astro';
import { email } from '../lib/contact';

const year = new Date().getFullYear();

const pages = [
  { href: '/cv', label: 'CV' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];

const projects = (
  await getCollection('projects', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => a.data.order - b.data.order);

// Round icon buttons under the email. LinkedIn isn't in simple-icons, so it
// gets the same "in" as on the contact page.
const socials = [
  { href: 'https://github.com/JermanLuka', label: 'GitHub', path: siGithub.path },
  { href: 'https://www.linkedin.com/in/luka-jerman-12046442b/', label: 'LinkedIn' },
  { href: '/rss.xml', label: 'RSS feed', path: siRss.path },
];

const isExternal = (href: string) => href.startsWith('http');
const linkClass = 'text-zinc-400 transition-colors hover:text-white';
const headingClass = 'text-xs font-semibold tracking-[0.14em] text-zinc-500 uppercase';
---

{/* A brand block, then link columns, then a thin bottom bar. On phones the
    brand block spans the top and the two columns sit side by side under it. */}
<footer class="border-t border-white/5">
  <div class="mx-auto max-w-6xl px-5 pt-16 pb-8 sm:px-6">
    <div class="grid grid-cols-2 gap-x-8 gap-y-12 md:grid-cols-[1.6fr_1fr_1.2fr]">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="inline-flex items-center gap-2.5 text-white transition-opacity hover:opacity-85">
          <LogoMark class="size-8 text-accent-700" />
          <span class="font-display text-lg tracking-[0.01em] uppercase">Luka Jerman</span>
        </a>
        <p class="mt-4 text-sm text-zinc-400">Software engineer.</p>

        <CopyEmail class="group mt-5 inline-flex items-center gap-2 text-sm font-medium text-white transition-colors hover:text-accent-400">
          {email}
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="size-4 opacity-60 transition-opacity group-hover:opacity-100"
          >
            <rect x="9" y="9" width="12" height="12" rx="2" />
            <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
          </svg>
        </CopyEmail>

        <ul class="mt-6 flex gap-2">
          {
            socials.map(({ href, label, path }) => (
              <li>
                <a
                  href={href}
                  aria-label={label}
                  target={isExternal(href) ? '_blank' : undefined}
                  rel={isExternal(href) ? 'me noopener noreferrer' : undefined}
                  class="flex size-9 items-center justify-center rounded-full bg-white/5 text-zinc-400 ring-1 ring-white/10 transition hover:bg-white/10 hover:text-white"
                >
                  {path ? (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4">
                      <path d={path} />
                    </svg>
                  ) : (
                    <span aria-hidden="true" class="text-sm font-bold">in</span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class={headingClass}>Site</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            pages.map(({ href, label }) => (
              <li>
                <a href={href} class={linkClass}>{label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class={headingClass}>Projects</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            projects.map((project) => (
              <li>
                <a href={`/projects/${project.id}`} class={linkClass}>{project.data.title}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-white/5 pt-6 text-sm text-zinc-500">
      <p>&copy; {year} Luka Jerman</p>

      {/* Phones only: the header has no room for it there. */}
      <div class="flex items-center gap-3 sm:hidden">
        {/* The trigger already names itself for screen readers. */}
        <span aria-hidden="true">Accent</span>
        <AccentMenu position="above" />
      </div>
    </div>
  </div>
</footer>
