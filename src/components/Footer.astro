---
import AccentMenu from './AccentMenu.astro';

const year = new Date().getFullYear();

const socials = [
  { href: 'https://github.com/JermanLuka', label: 'GitHub' },
  {
    href: 'https://www.linkedin.com/in/luka-jerman-12046442b/',
    label: 'LinkedIn',
  },
  { href: '/contact', label: 'Contact' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<footer class="border-t border-white/5">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-8 text-sm text-zinc-500 sm:px-6">
    <p>&copy; {year} Luka Jerman</p>

    <ul class="flex gap-4">
      {
        socials.map(({ href, label }) => (
          <li>
            <a
              href={href}
              target={href.startsWith('http') ? '_blank' : undefined}
              rel={href.startsWith('http') ? 'me noopener noreferrer' : undefined}
              class="transition-colors hover:text-white"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    {/* Phones only: the header has no room for it there. */}
    <div class="flex w-full items-center gap-3 sm:hidden">
      {/* The trigger already names itself for screen readers. */}
      <span aria-hidden="true">Accent</span>
      <AccentMenu position="above" />
    </div>
  </div>
</footer>
