---
import type { Skill } from '../lib/skills';

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;
---

<ul class="not-prose grid grid-cols-2 gap-2.5 sm:grid-cols-3">
  {
    skills.map((skill) => (
      <li
        class="skill flex items-center gap-3 rounded-lg border border-slate-200 bg-white/60 px-3 py-2.5 dark:border-slate-800 dark:bg-slate-900/40"
        style={`--brand:#${skill.hex};--brand-dark:#${skill.darkHex ?? skill.hex}`}
      >
        <span class="mark flex h-5 w-5 shrink-0 items-center justify-center">
          {skill.path ? (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5">
              <path d={skill.path} />
            </svg>
          ) : (
            <span class="text-[0.7rem] font-bold leading-none tracking-tight">
              {skill.text}
            </span>
          )}
        </span>

        <span class="truncate text-sm text-slate-700 dark:text-slate-300">
          {skill.name}
        </span>
      </li>
    ))
  }
</ul>

<style>
  .skill {
    /* Colour and lift are the only moving parts - the tile itself stays put
       until hovered, so the grid reads as a calm block of logos. */
    transition:
      border-color 150ms ease,
      transform 150ms ease,
      box-shadow 150ms ease;
  }

  .mark {
    color: var(--brand);
  }

  .mark svg {
    fill: currentColor;
  }

  .skill:hover {
    border-color: color-mix(in srgb, var(--brand) 55%, transparent);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px -10px color-mix(in srgb, var(--brand) 70%, transparent);
  }
  :global([data-theme='dark']) .mark {
    color: var(--brand-dark);
  }
  :global([data-theme='dark']) .skill:hover {
    border-color: color-mix(in srgb, var(--brand-dark) 55%, transparent);
    box-shadow: 0 6px 18px -10px
    color-mix(in srgb, var(--brand-dark) 60%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .skill,
    .skill:hover {
      transform: none;
      transition: border-color 150ms ease;
    }
  }
</style>
