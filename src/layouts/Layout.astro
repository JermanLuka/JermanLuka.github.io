---
// Self-hosted through Fontsource, so no font is requested from Google.
import '@fontsource/anton';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { accents, defaultAccent } from '../lib/accents';
import Aurora from '../components/Aurora.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';

interface Props {
  title?: string;
  description?: string;
  /** Set on blog posts so link previews and search engines treat them as articles. */
  article?: { published: Date };
  /**
   * How wide the content column is. 'narrow' suits reading (posts, project
   * write ups), 'wide' suits grids, and 'full' hands the page the whole width
   * to lay out its own sections (the home page).
   */
  width?: 'narrow' | 'wide' | 'full';
}

const {
  title = 'Luka Jerman',
  description = 'Personal site of Luka Jerman: projects, writing, and what I am building.',
  article,
  width = 'narrow',
} = Astro.props;

const column = {
  narrow: 'mx-auto w-full max-w-3xl px-5 pt-14 pb-24 sm:px-6 sm:pt-20',
  wide: 'mx-auto w-full max-w-6xl px-5 pt-14 pb-24 sm:px-6 sm:pt-20',
  full: '',
}[width];

// build.format is 'file', so pathname is '/cv.html' at build time. Strip the
// extension so the canonical matches the extensionless URL we link and index.
const cleanPath = Astro.url.pathname.replace(/(?:index)?\.html$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site);
const socialImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
{/* The design is dark only, so tell the browser: scrollbars and form
    controls then match without any per-element styling. */}
<html lang="en" style="color-scheme: dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    {/* Google reads a raster icon for the favicon beside a search result, and
        requires a square multiple of 48px - it will not use the 32. */}
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Luka Jerman"
      href="/rss.xml"
    />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Luka Jerman" />
    {
      article && (
        <meta
          property="article:published_time"
          content={article.published.toISOString()}
        />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Applies a saved accent before the body is parsed, on purpose. Run any
      later and someone who chose blue would see a red flash on every
      navigation. `define:vars` hands it the list of colours and also keeps it
      inline, out of the deferred module scripts, which would arrive too late.
      The default needs no attribute.
    */}
    <script define:vars={{ choices: accents.map((accent) => accent.id), fallback: defaultAccent }}>
      try {
        const saved = localStorage.getItem('accent');
        if (saved !== fallback && choices.includes(saved)) {
          document.documentElement.dataset.accent = saved;
        }
      } catch {
        // Storage blocked: stay on the default.
      }
    </script>
  </head>

  <body class="bg-page font-body text-zinc-300 antialiased selection:bg-accent-600/50 selection:text-white">
    {/* overflow-x-clip trims the background glows at the screen edge without
        turning this into a scroll container, which would break the sticky header. */}
    <div class="relative isolate flex min-h-screen flex-col overflow-x-clip">
      <Aurora />
      <Header />
      <main class:list={['flex-1', column]}>
        <slot />
      </main>
      <Footer />
    </div>
    {/* Outside the wrapper on purpose: a fixed element inside a frosted
        .glass panel would be pinned to that panel instead of the screen. */}
    <Toast />
  </body>
</html>
